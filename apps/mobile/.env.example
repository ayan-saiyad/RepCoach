# Expo public values are embedded in the client bundle. Never put API keys,
# credentials, or private endpoints here.
#
# Local Expo development may use a LAN HTTP address, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
#
# EAS preview and production builds must set this in their EAS environment to
# the public HTTPS API origin. Do not commit the real deployment value.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
