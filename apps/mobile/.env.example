# Expo public values are embedded in the client bundle. Never put API keys,
# credentials, or private endpoints here.
#
# Local Expo development may use a LAN HTTP address, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
#
# EAS preview and production builds must set this in their EAS environment to
# the public HTTPS API origin. Do not commit the real deployment value.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Public OAuth metadata is safe to embed in a native app. It identifies the
# Cognito client but grants no authority; tokens are stored in the platform
# credential store after a PKCE authorization-code exchange.
#
# The deployed Cognito mobile client must allow this exact callback and signout
# URI. Keep the scheme aligned with `app.json`.
EXPO_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_CLIENT_ID=your-public-mobile-client-id
EXPO_PUBLIC_COGNITO_REDIRECT_URI=repcoach://auth/callback
# Optional; defaults to: openid profile email
EXPO_PUBLIC_COGNITO_SCOPES=openid profile email

# Development builds default to the deterministic replay. Signed preview and
# production builds ignore this value so simulated motion is never presented as
# a live workout.
EXPO_PUBLIC_DEMO_MODE=true
