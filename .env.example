# Infrastructure
POSTGRES_DB=repcoach
POSTGRES_USER=repcoach
POSTGRES_PASSWORD=repcoach_local_only
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgresql+asyncpg://repcoach:repcoach_local_only@localhost:5433/repcoach
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=repcoach
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
REDIS_URL=redis://localhost:6380/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_SSL=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# Keep plaintext for local Docker/Redpanda. MSK Serverless requires msk_iam
# and a task role with kafka-cluster permissions.
KAFKA_AUTH_MODE=plaintext
KAFKA_AWS_REGION=

# API / worker
APP_ENV=development
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true
AUTH_DISABLED=true
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_IDS=
COGNITO_TOKEN_USE=access
EDGE_ORIGIN_REQUIRED=false
EDGE_ORIGIN_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
FORM_MODEL_PATH=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancelled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Client apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
